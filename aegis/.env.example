# Live Jev decisions. Without this, Aegis uses a deterministic mock judge.
TYPESAFE_API_KEY=

# Optional. If set, requireReasoning asks the model for a real trace.
OPENAI_API_KEY=

# Optional. Where the local SQLite ledger lives. Defaults to ./data/aegis.db
AEGIS_DB_PATH=

# Photon Spectrum sends the decision as an iMessage to these Apple ID emails.
# The operator address always receives a copy. Without these, the alert is recorded only.
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Loan Approval agent opens a cloud browser when these are set.
# Without them, credit decisions still run and record that Browserbase was skipped.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# CodeRabbit CLI review. The Platform tab still offers the review when these are empty.
CODERABBIT_API_KEY=
CODERABBIT_REGION=

# Whop subscription checkout for wrapping existing agents.
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
WHOP_PRODUCT_ID=

# Cognition Devin sessions. The handoff is stored when these are empty.
DEVIN_API_KEY=
DEVIN_ORG_ID=

# GMI Cloud inference for the loan agent's reasoning trace, and the local Docker deploy.
GMI_API_KEY=
GMI_MODEL=meta-llama/Llama-3.3-70B-Instruct

# The AI Collective calendar is public (https://lu.ma/genai-collective). No key.
# A feedback copy uses the Photon keys above and goes only to the operator.
